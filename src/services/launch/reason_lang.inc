/* 内置原因文案表 —— 与 src/core/instance/lang_table.inc 同一套写法(键值对),
 * 但**不是**生成物:原因键(out_of_memory / mixin_failure …)是 C 版新加的一层,
 * 中英文案都在这里手写,改文案只改这一个文件。
 *
 * 键名约定(用户语言包可以逐条覆盖,见 lang.c 的覆盖规则):
 *   crash.reason.<key>          短名(如 "内存不足(Java 堆耗尽)")
 *   crash.reason.<key>.advice   可执行建议(如 "把最大内存调到 4096MB…")
 * 表里**必须**覆盖 sxcl_log_reason 的每一个取值(除 COUNT):测试会逐条断言,
 * 漏一条就是 UI 上出现空白建议。顺序与枚举一致,便于人对照。
 */

typedef struct sxcl_reason_kv {
    sxcl_log_reason reason;
    const char *key;
    const char *name;
    const char *advice;
} sxcl_reason_kv;

