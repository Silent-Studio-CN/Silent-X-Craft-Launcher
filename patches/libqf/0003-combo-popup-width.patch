+// ================================================================
+// 补全弹层:与下拉弹层同一条宽度规矩(用户 2026-09-27)
+// ================================================================
+namespace {
+
+// python/qf 的下拉弹层宽度规矩在 ComboBoxMenu::applyHostWidthPolicy(fluent_menu.cpp);
+// 补全弹层是 QCompleter 自己的 QListView(Qt 在 show 之前 setGeometry),所以规矩装在
+// Show 事件上:真正显示前改成"宿主窗口可用宽度 + 左缘对齐窗口",条目照样换行、不省略。
+class CompleterPopupPolicy : public QObject {
+public:
+    CompleterPopupPolicy(QWidget *host, QAbstractItemView *popup)
+        : QObject(popup), m_host(host), m_popup(popup) {}
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override {
+        if (event->type() == QEvent::Show && m_host != nullptr && m_popup != nullptr)
+            widenToHostWindow();
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    void widenToHostWindow() {
+        QWidget *top = m_host->window() != nullptr ? m_host->window() : m_host.data();
+        const int winW = top->width();
+        if (winW <= 0)
+            return;
+        const QScreen *screen = m_popup->screen() != nullptr ? m_popup->screen()
+                                                            : QGuiApplication::primaryScreen();
+        int width = qMax(winW - 24, 160);   // 铺满宿主窗口,两侧各留 12
+        if (screen != nullptr) {
+            const QRect avail = screen->availableGeometry();
+            width = qMin(width, qMax(avail.width() - 16, 160));
+        }
+        int x = top->mapToGlobal(QPoint(0, 0)).x() + 12;
+        if (screen != nullptr) {
+            const QRect avail = screen->availableGeometry();
+            x = qMin(x, avail.right() + 1 - width);
+            x = qMax(x, avail.left());
+        }
+        const QRect geo = m_popup->geometry();
+        m_popup->setGeometry(x, geo.y(), width, geo.height());
+    }
+
+    QPointer<QWidget> m_host;
+    QPointer<QAbstractItemView> m_popup;
+};
+
+} // namespace
+
+void LineEdit::setCompleter(QCompleter *completer) {
+    QLineEdit::setCompleter(completer);
+    if (m_completerPolicy != nullptr) {
+        m_completerPolicy->deleteLater();
+        m_completerPolicy = nullptr;
+    }
+    if (completer == nullptr)
+        return;
+    QAbstractItemView *popup = completer->popup();
+    if (popup == nullptr)
+        return;
+    // 同一条规矩在补全弹层上的形态:不省略、不横向压缩(宽度由 Show 事件对齐窗口)
+    popup->setTextElideMode(Qt::ElideNone);
+    popup->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    if (QListView *list = qobject_cast<QListView *>(popup))   // setWordWrap 只在 QListView 上
+        list->setWordWrap(true);
+    m_completerPolicy = new CompleterPopupPolicy(this, popup);
+    popup->installEventFilter(m_completerPolicy);
+}
