+// ================================================================
+// 弹层宽度规矩(用户 2026-09-27:铺满窗口,放不下换行)
+// ================================================================
+int ComboBoxMenu::itemTextWidth(int row) const {
+    if (m_view == nullptr || row < 0 || row >= m_view->count())
+        return 0;
+    const QListWidgetItem *item = m_view->item(row);
+    if (item == nullptr)
+        return 0;
+    const int viewW = m_view->width() > 0 ? m_view->width() : qMax(m_policyViewWidth, 0);
+    return qMax(0, viewW - kItemTextInset - (item->icon().isNull() ? 0 : kItemIconInset));
+}
+
+int ComboBoxMenu::longestUnbreakableRun() const {
+    // "不可断开的片段" = 一条文字里不含空白的连续一段。换行只能断在空白处,所以最长的那一段
+    // 决定了"不硬折、不裁字"至少要多宽 —— 路径(\ 和 : 都不是断点)就是典型例子。
+    if (m_view == nullptr)
+        return 0;
+    const QFontMetrics fm(m_view->font());
+    int longest = 0;
+    for (int i = 0; i < m_view->count(); ++i) {
+        const QListWidgetItem *item = m_view->item(i);
+        if (item == nullptr)
+            continue;
+        const QString text = item->text();
+        int start = 0;
+        for (int p = 0; p <= text.size(); ++p) {
+            if (p != text.size() && !text.at(p).isSpace())
+                continue;
+            if (p > start)
+                longest = qMax(longest, fm.horizontalAdvance(text.mid(start, p - start)));
+            start = p + 1;
+        }
+    }
+    return longest;
+}
+
+void ComboBoxMenu::reflowItemForPolicy(int row) {
+    if (m_policyViewWidth <= 0 || m_view == nullptr)
+        return;
+    if (row < 0 || row >= m_view->count())
+        return;
+    QListWidgetItem *item = m_view->item(row);
+    if (item == nullptr)
+        return;
+    // 列表视图里条目横向**铺满视口**,item 的 sizeHint 宽只决定"视口该多宽"
+    // (adjustViewSize 取最宽条目 + 2 当视图宽),所以这里按视口宽倒推。
+    const int viewW = qMax(m_policyViewWidth, m_view->minimumWidth());
+    const int textW = qMax(24, viewW - kItemTextInset
+                                   - (item->icon().isNull() ? 0 : kItemIconInset));
+    const QFontMetrics fm(m_view->font());
+    int rowH = m_itemHeight;
+    if (fm.horizontalAdvance(item->text()) > textW) {
+        // 换行:用 Qt 自己的文本引擎(与绘制同一条排版路径)量行数与高度。
+        // 词边界优先;整段装不下时允许在任意位置折(WrapAtWordBoundaryOrAnywhere),
+        // 这样"一条放不下就换行"对任何文字都成立,不会剩一段被裁掉。
+        QTextLayout layout(item->text(), m_view->font());
+        QTextOption option;
+        option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+        layout.setTextOption(option);
+        layout.beginLayout();
+        qreal used = 0;
+        for (;;) {
+            QTextLine line = layout.createLine();
+            if (!line.isValid())
+                break;
+            line.setLineWidth(textW);
+            used += line.height();
+        }
+        layout.endLayout();
+        // +8 = ::item 的上下留白(#comboListWidget::item margin-top 4 + 底 4)
+        rowH = qMax(m_itemHeight, static_cast<int>(used) + 8);
+    }
+    item->setSizeHint(QSize(qMax(1, viewW - 2), rowH));
+}
+
+void ComboBoxMenu::reflowItemsForPolicy() {
+    if (m_policyViewWidth <= 0 || m_view == nullptr)
+        return;
+    for (int i = 0; i < m_view->count(); ++i)
+        reflowItemForPolicy(i);
+}
+
+int ComboBoxMenu::applyHostWidthPolicy(QWidget *host, int sideMargin) {
+    if (m_view == nullptr)
+        return 0;
+    if (host == nullptr)
+        host = parentWidget();
+    if (host == nullptr)
+        return 0;
+    m_policySideMargin = qMax(0, sideMargin);
+    // 字体要先抛光:视图的 14px 来自 menu.qss,不抛光时量到的是应用默认字体,行数会算错。
+    m_view->ensurePolished();
+
+    QWidget *top = host->window() != nullptr ? host->window() : host;
+    const int winW = top->width() > 0 ? top->width() : host->width();
+    // ① 铺满宿主窗口的可用宽度(两侧各留 sideMargin,免得贴边)
+    int target = qMax(winW - m_policySideMargin * 2, qMin(host->width(), winW));
+    // ②/③ 窗口比"一条不可断开的片段"还窄时,弹层只长到刚好装下它(仍然不裁字)
+    const int run = longestUnbreakableRun();
+    if (run > 0)
+        target = qMax(target, run + kItemTextInset + kItemIconInset);
+    // ④ 上限 = 光标所在屏的可用宽度 - 16(比屏幕还宽 = 换个方向看不全)
+    const QRect ss = currentScreenGeometry();
+    if (ss.isValid())
+        target = qMin(target, qMax(ss.width() - 16, 120));
+    m_policyViewWidth = qMax(target, 1);
+
+    m_view->setWordWrap(true);
+    reflowItemsForPolicy();
+    m_view->setMinimumWidth(m_policyViewWidth);
+    adjustViewSize(QPoint(), MenuAnimationType::None);
+    adjustSize();
+    return m_policyViewWidth;
+}
