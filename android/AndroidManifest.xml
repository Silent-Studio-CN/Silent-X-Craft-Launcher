<?xml version="1.0"?>
<manifest package="com.silentstudio.sxcl" xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionName="0.2.0-android" android:versionCode="2" android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Shared storage. Minecraft data (game dir, saves, mods, resource packs) lives
         on /storage/emulated/0, and HMCL/FCL/PojavLauncher put their .minecraft there.
         Measured on 192.168.220.33 (Android 16, targetSdk 34): with only the two
         permissions above, stat("/storage/emulated/0/FCL/.minecraft") from our uid
         returns EACCES, so auto-detection could never see the user's game directory.
         MANAGE_EXTERNAL_STORAGE ("All files access") is what unlocks it; the user
         grants it in system settings, and the launcher offers that page directly.
         NOTE: this is a Google Play *restricted* permission - publishing on Play
         requires a declaration form; side-loading / self-use is unaffected.
         Android 10 and below use the legacy READ/WRITE pair instead, hence the
         maxSdkVersion caps (WRITE has been a no-op since Android 11 / API 30). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <!-- "Display over other apps" (SYSTEM_ALERT_WINDOW). NOT needed for the
         floating window itself: the maximise button uses picture-in-picture
         first, which is a plain activity flag and needs no permission.
         This permission is only the FALLBACK panel: when the device/ROM refuses
         PiP, the launcher shows a small native panel over other apps. It is
         granted by the user in system settings (Settings.canDrawOverlays), and
         the launcher opens that page for them. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <application android:label="Silent X Craft Launcher" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:hardwareAccelerated="true">
        <activity android:name="com.silentstudio.sxcl.SxclActivity"
            android:label="Silent X Craft Launcher" android:icon="@mipmap/ic_launcher"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc"
            android:launchMode="singleTop" android:screenOrientation="unspecified" android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data android:name="android.app.lib_name" android:value="sxclui"/>
        </activity>

        <!-- 游戏进程(= 用户 2026-09-21 拍板的 B 方案:游戏自己一个进程 + 自己一个窗口)。
             逐条说明为什么是这些属性:
               * android:process=":game"      游戏与启动器**不同进程**。进程内起的 JVM 崩了、
                                              被 OOM 杀了,启动器不受影响(反过来也一样)。
               * exported="false"             只有本应用能拉起它(没有 intent-filter)。
               * launchMode="singleTask"      同一个游戏只有一个实例(再次启动复用同一个进程)。
               * resizeableActivity="true"    允许分屏/自由窗口形态(游戏窗口不跟启动器抢)。
               * configChanges=...            旋转/键盘/尺寸/密度/深色模式变化时**不重建**
                                              Activity —— 游戏进程重不重建不该由系统说了算。
               * taskAffinity="...game"       **必须**:singleTask 如果与启动器同一个 task,
                                              会把启动器从栈上清掉,启动器的画中画也一起没;
                                              独立 affinity + FLAG_ACTIVITY_NEW_TASK 才是
                                              "游戏一个 task、启动器一个 task"。
               * theme=NoActionBar.Fullscreen 游戏窗口不要标题栏/操作栏,整块 surface 归游戏。 -->
        <activity android:name="com.silentstudio.sxcl.GameActivity"
            android:label="Silent X Craft Launcher - 游戏"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.silentstudio.sxcl.game"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode"/>
    </application>
</manifest>
