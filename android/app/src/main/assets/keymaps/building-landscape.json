{
  "schema": "sxcl.keymap.v1",
  "name": "建造",
  "screen": "landscape",
  "mc_version": "",
  "description": "搭建筑/红石用：带快捷栏 1-9 与飞行上下",
  "meta": {
    "builtin": true,
    "recommended_for": "building",
    "guide": [
      {
        "order": 1,
        "title": "会走路",
        "instruction": "推住左边的摇杆/方向键往前走",
        "why": "键盘上是 W。推到底会快走",
        "control_id": "move",
        "keys": [
          "KEY_W"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 2,
        "title": "会跳",
        "instruction": "点一下「跳」",
        "why": "键盘是空格。长按可以连续跳，跳一格高的坎不用手忙脚乱",
        "control_id": "jump",
        "keys": [
          "KEY_SPACE"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 3,
        "title": "会挖方块/打怪",
        "instruction": "长按「挖」，对着方块/怪物",
        "why": "键盘是鼠标左键。长按=一直挖，别一下一下点，手指会累",
        "control_id": "mine",
        "keys": [
          "MOUSE_LEFT"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 4,
        "title": "会放方块/用东西",
        "instruction": "点一下「放」",
        "why": "键盘是鼠标右键。开门、喂动物、吃食物都是它",
        "control_id": "place",
        "keys": [
          "MOUSE_RIGHT"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 5,
        "title": "不会掉下去",
        "instruction": "按住「潜行」再走到方块边缘",
        "why": "键盘是 Shift。边缘不会掉下去，搭桥必备；双击可以切成常驻潜行",
        "control_id": "sneak",
        "keys": [
          "KEY_LEFT_SHIFT"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 6,
        "title": "会开背包",
        "instruction": "点一下「背包」",
        "why": "键盘是 E。长按一般是聊天",
        "control_id": "inventory",
        "keys": [
          "KEY_E"
        ],
        "tap": "press",
        "optional": false
      },
      {
        "order": 7,
        "title": "会疾跑",
        "instruction": "按住「疾跑」同时往前推",
        "why": "键盘是 Ctrl；也可以双击前进方向",
        "control_id": "sprint",
        "keys": [
          "KEY_LEFT_CTRL"
        ],
        "tap": "press",
        "optional": true
      },
      {
        "order": 8,
        "title": "会换物品",
        "instruction": "点底部 1-9 切换手上的物品",
        "why": "键盘就是数字键 1-9；建造时不用开背包翻",
        "control_id": "slot1",
        "keys": [
          "KEY_1"
        ],
        "tap": "press",
        "optional": true
      },
      {
        "order": 9,
        "title": "会看四周",
        "instruction": "在屏幕空白处滑动 = 转动视角；两根手指滑动 = 移动（如果布局开了双区）",
        "why": "这是 FCL 里最容易卡住的一步：很多人以为要点了按钮才能转身",
        "control_id": "",
        "keys": [],
        "tap": "press",
        "optional": true
      }
    ],
    "generator": "SXCL 0.1.0",
    "screen_label": "横屏",
    "preset": "building"
  },
