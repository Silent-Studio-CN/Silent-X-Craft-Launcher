# Project-wide Gradle settings.
# For more details on how to configure your build environment visit
# http://www.gradle.org/docs/current/userguide/build_environment.html
# Specifies the JVM arguments used for the daemon process.
# The setting is particularly useful for tweaking memory settings.
org.gradle.jvmargs=-Xmx3200m -XX:MaxMetaspaceSize=768m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8

# Enable building projects in parallel
org.gradle.parallel=true

# Gradle caching allows reusing the build artifacts from a previous
# build with the same inputs. However, over time, the cache size will
# grow. Uncomment the following line to enable it.
#org.gradle.caching=true
#org.gradle.configuration-cache=true

# Allow AndroidX usage
android.useAndroidX=true

# User-defined properties
@EXTRA_PROPERTIES@
androidBuildToolsVersion=@BUILD_TOOLS@
androidCompileSdkVersion=android-@COMPILE_SDK@
androidNdkVersion=@NDK_VERSION@
androidPackageName=@PACKAGE_NAME@
buildDir=build
legacyPackaging=false
qt5AndroidDir=@QT_ANDROID@/./src/android/java
qtAndroidDir=@QT_ANDROID@/./src/android/java
qtGradlePluginType=com.android.application
qtMinSdkVersion=@MIN_SDK@
qtTargetAbiList=@ABI_LIST@
qtTargetSdkVersion=@TARGET_SDK@
